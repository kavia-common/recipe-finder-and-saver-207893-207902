# Backend environment variables (do not commit real secrets)

# Database (preferred)
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# Or use components to assemble (optional)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5000
# POSTGRES_DB=myapp
# POSTGRES_USER=appuser
# POSTGRES_PASSWORD=dbuser123

# Auth
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=10080

# CORS
# Use "*" for dev, or comma-separated list like: http://localhost:3000,https://yourdomain.com
CORS_ALLOW_ORIGINS=*

# Optional
SITE_URL=http://localhost:3000
